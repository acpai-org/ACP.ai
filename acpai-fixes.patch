+
+// ─── single-rule precision (line numbers, severity, hints) ────────────────────
+
+describe("AC4 lint — single-rule precision", () => {
+  test("missing-spdx fires as a warning and its hint says exactly what to add", () => {
+    const source = `pragma solidity ^0.8.23;
